{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/oscar-portfolio/browser",
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/projects/portfolio-engineering/?",
      "dest": "/projects/portfolio-engineering/index.html"
    },
    {
      "src": "/projects/sentinel/?",
      "dest": "/projects/sentinel/index.html"
    },
    {
      "src": "/design-system/?",
      "dest": "/design-system/index.html"
    },
    {
      "src": "/projects/lol-scenario-trainer/?",
      "dest": "/projects/lol-scenario-trainer/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404/index.html",
      "status": 404
    }
  ]
}
